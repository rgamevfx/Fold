      "source": "pub fn animate(input: MotionContext<'_>) -> Result<MotionPose, String> {\n    let duration = input.number(\"Duration\")? as f32;\n    let t = ((input.seconds() - input.number(\"Delay\")?).max(0.) as f32).min(duration);\n    let curve = fframes::animation::AnimationRuntime::new(duration, &fframes::animation::Easing::EaseOut);\n    let p = curve.solve(&t) as f64;\n    Ok(MotionPose {\n        position: [0., input.number(\"Distance\")? * (1. - p)],\n        opacity: p,\n        ..Default::default()\n    })\n}"
    },
