  "workflow": {
    "author": "candidate begin, then author with bounded SDK JavaScript or candidate edit with a typed batch; use the returned generation and revision for the next edit",
    "commit": "candidate commit with base revision, generation and label; one undo step",
    "discover": "catalog method for exact request schemas; catalog type for package operations",
    "evaluate": "inspect/render with candidate, generation and project_epoch; evidence is only valid for that generation",
    "guidance": "catalog guide=workflow; fetch referenced topic names through catalog guide",
    "limits": "four candidates; 900 idle seconds; 4096 mutations and 64 MiB document payload per candidate",
    "sdk": "catalog sdk=true returns the native fluent authoring SDK and generated operation declarations",
    "unsupported": [
      "automatic rebase",
      "TypeScript type stripping; author executes JavaScript",
      "analytical motion verification"
    ]
  }
